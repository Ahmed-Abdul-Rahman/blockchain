{
  "name": "blockchain",
  "version": "1.0.0",
  "description": "Blockchain Implementation",
  "main": "build/src/index.js",
  "type": "module",
  "scripts": {
    "start": "node build/src/index.js",
    "dev": "nodemon --exec tsx -r tsconfig-paths/register src/index.ts",
    "node": "tsx -r tsconfig-paths/register src/index.ts",
    "node_1": "nodemon --exec tsx -r tsconfig-paths/register src/index.ts 3001 http://localhost:3001",
    "node_2": "nodemon --exec tsx -r tsconfig-paths/register src/index.ts 3002 http://localhost:3002",
    "node_3": "nodemon --exec tsx -r tsconfig-paths/register src/index.ts 3003 http://localhost:3003",
    "node_4": "nodemon --exec tsx -r tsconfig-paths/register src/index.ts 3004 http://localhost:3004",
    "node_5": "nodemon --exec tsx -r tsconfig-paths/register src/index.ts 3005 http://localhost:3005",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf build",
    "build": "npm run clean && tsc -p tsconfig.json && tsc-alias --resolve-full-paths",
    "sim": "NODE_ENV=perf node build/packages/core/_tests/SimulateMultiNode.int.js --nodes 10 --duration 300",
    "sim:peak": "NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=perf node build/packages/core/_tests/SimulateMultiNode.int.js --nodes 50 --duration 1500",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "prepare": "husky"
  },
  "author": "Ahmed Abdul Rahman",
  "license": "ISC",
  "nodemonConfig": {
    "ignore": [
      "**/test/**",
      "**/docs/**",
      "node_modules/**/node_modules"
    ],
    "watch": [
      "src",
      "packages"
    ],
    "ext": "ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.0",
    "@chainsafe/libp2p-noise": "^16.0.1",
    "@chainsafe/libp2p-yamux": "^7.0.1",
    "@libp2p/bootstrap": "^11.0.47",
    "@libp2p/crypto": "^5.1.8",
    "@libp2p/identify": "^3.0.15",
    "@libp2p/mdns": "^11.0.17",
    "@libp2p/peer-id": "^5.0.10",
    "@libp2p/tcp": "^10.0.15",
    "@noble/ed25519": "^3.0.0",
    "@types/lodash-es": "^4.17.12",
    "axios": "^1.7.9",
    "bloom-filters": "^3.0.4",
    "body-parser": "^1.20.3",
    "crc-32": "^1.2.2",
    "eventid": "^2.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "it-length-prefixed": "^9.1.1",
    "it-map": "^3.1.1",
    "it-pipe": "^3.0.1",
    "it-pushable": "^3.2.3",
    "libp2p": "^2.5.0",
    "lodash-es": "^4.17.21",
    "rotating-file-stream": "^3.2.7",
    "tslog": "^4.9.3",
    "uuid": "^11.0.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^17.10.2",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.1.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}