{
  "name": "blockchain",
  "version": "1.0.0",
  "author": "Ahmed Abdul Rahman",
  "description": "Monorepo of Blockchain Implementation",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "postinstall": "yarn run scanMalware",
    "foreach-workspace": "yarn workspaces foreach --topological-dev -Avi --exclude .",
    "blockchain": "yarn workspace @dechat/blockchain",
    "core": "yarn workspace @dechat/core",
    "crypto": "yarn workspace @dechat/crypto",
    "common": "yarn workspace @dechat/common",
    "clean": "yarn cache clear && yarn foreach-workspace -p run clean",
    "clean:deps": "yarn clean && node ./scripts/removeFolderRecursive ./node_modules",
    "backend-node": "yarn workspace backend-node run",
    "build": "yarn foreach-workspace run build",
    "test": "yarn foreach-workspace run test",
    "test:int": "yarn core test:int",
    "lint": "eslint .",
    "lint:backend-node": "eslint apps/backend",
    "lint:blockchain": "eslint packages/blockchain",
    "lint:core": "eslint packages/core",
    "lint:crypto": "eslint packages/crypto",
    "lint:common": "eslint packages/common",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,tsx,jsx,json,md}\"",
    "prepare": "husky",
    "scanMalware": "node scripts/shai-hulud-scan.js"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^17.10.2",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.1.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.12.0"
}