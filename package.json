{
  "name": "blockchain",
  "version": "1.0.0",
  "author": "Ahmed Abdul Rahman",
  "description": "Monorepo of Blockchain Implementation",
  "type": "module",
  "scripts": {
    "foreach-workspace": "yarn workspaces foreach -Avi --exclude root",
    "chain": "yarn workspace @dechat/chain",
    "core": "yarn workspace @dechat/core",
    "crypto": "yarn workspace @dechat/crypto",
    "logger": "yarn workspace @dechat/logger",
    "build": "yarn foreach-workspace run build",
    "clean": "yarn cache clear && yarn foreach-workspace -p run clean",
    "clean:deps": "yarn clean && node ./scripts/removeFolderRecursive ./node_modules",
    "backend-node": "yarn workspace backend-node run",
    "test": "yarn foreach-workspace run test",
    "lint": "eslint .",
    "lint:backend-node": "eslint apps/backend",
    "lint:chain": "eslint packages/chain",
    "lint:core": "eslint packages/core",
    "lint:crypto": "eslint packages/crypto",
    "lint:logger": "eslint packages/logger",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,tsx,jsx,json,md}\"",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "ISC",
  "nodemonConfig": {
    "ignore": [
      "**/test/**",
      "**/docs/**",
      "node_modules/**/node_modules"
    ],
    "watch": [
      "apps",
      "packages"
    ],
    "ext": "ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^17.10.2",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.1.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.9.4"
}