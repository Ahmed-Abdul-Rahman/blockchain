{
  "name": "@dechat/chat",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "development": "./browser.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "development": "./index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "development": "./node.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "development": "./browser.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias --resolve-full-paths",
    "clean": "rm -rf dist",
    "test": "../../node_modules/.bin/vitest run tests/unit",
    "test:coverage": "../../node_modules/.bin/vitest run --coverage tests/unit",
    "test:int": "NODE_ENV=perf LOG_LEVEL=INFO ../../node_modules/.bin/vitest run tests/interop --testTimeout=90000 --fileParallelism=false",
    "bootstrap": "../../node_modules/.bin/tsx --conditions=development src/bootstrap/runBootstrap.ts"
  },
  "dependencies": {
    "@dechat/common": "*",
    "@dechat/core": "*",
    "@dechat/crypto": "*",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
