{
  "name": "@dechat/core",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "development": "./index.ts",
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx --conditions=development src/testNode.ts",
    "build": "tsc -p tsconfig.json && tsc-alias --resolve-full-paths",
    "fixBuild": "tsc-esm-fix --target dist --ext .js",
    "clean": "rm -rf dist",
    "test:file": "vitest run",
    "test": "../../node_modules/.bin/vitest run **/*.unit.test.ts",
    "test:coverage": "../../node_modules/.bin/vitest run --coverage",
    "test:int": "yarn test:int:startup && yarn test:int:data-sync",
    "test:int:startup": "NODE_ENV=perf LOG_LEVEL=INFO node --trace-warnings dist/tests/interop/interOpStartupTestRunner.int.js",
    "test:int:data-sync": "NODE_ENV=perf LOG_LEVEL=INFO node --trace-warnings dist/tests/interop/interOpDataSyncTestRunner.int.js",
    "test:int:narrow": "yarn test:int:startup:narrow && yarn test:int:data-sync:narrow",
    "test:int:startup:narrow": "NODE_ENV=perf LOG_LEVEL=INFO node --trace-warnings dist/tests/interop/interOpStartupTestRunner.int.js --nodes 3 --duration 30",
    "test:int:data-sync:narrow": "NODE_ENV=perf LOG_LEVEL=INFO node --trace-warnings dist/tests/interop/interOpDataSyncTestRunner.int.js --nodes 3 --duration 30",
    "sim": "NODE_ENV=perf node dist/tests/interop/initiateTest.js --nodes 3 --duration 30",
    "sim:peak": "NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=perf node dist/tests/interop/SimulateMultiNode.int.js --nodes 50 --duration 1500"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.0",
    "@chainsafe/libp2p-noise": "^16.0.1",
    "@chainsafe/libp2p-yamux": "^7.0.1",
    "@datastructures-js/priority-queue": "^6.3.5",
    "@datastructures-js/queue": "^4.3.0",
    "@dechat/common": "*",
    "@dechat/crypto": "*",
    "@libp2p/bootstrap": "^11.0.47",
    "@libp2p/crypto": "^5.1.8",
    "@libp2p/identify": "^3.0.15",
    "@libp2p/mdns": "^11.0.17",
    "@libp2p/peer-id": "^5.0.10",
    "@libp2p/peer-id-factory": "^4.2.4",
    "@libp2p/tcp": "^10.0.15",
    "@noble/ed25519": "^3.0.0",
    "bloom-filters": "^3.0.4",
    "es-toolkit": "^1.42.0",
    "it-length-prefixed": "^9.1.1",
    "it-map": "^3.1.1",
    "it-pipe": "^3.0.1",
    "it-pushable": "^3.2.3",
    "level": "^8.0.0",
    "libp2p": "^2.5.0",
    "lru-cache": "^11.2.4",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
