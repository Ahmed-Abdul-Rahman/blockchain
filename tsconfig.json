{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@dechat/logger/*": [
                "packages/logger/src/*"
            ],
            "@dechat/core/*": [
                "packages/core/src/*"
            ],
            "@dechat/crypto/*": [
                "packages/crypto/src/*"
            ],
            "@dechat/chain/*": [
                "packages/chain/src/*"
            ]
        },
    },
    "include": [
        "./apps/**/*",
        "./packages/**/*",
        "_tests",
    ],
}